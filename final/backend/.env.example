# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/photography-contest?retryWrites=true&w=majority

# Port for backend server
PORT=5001

# JSON Web Token Secret
JWT_SECRET=replace_this_with_a_secure_random_string

# API key for secure communication between frontend and backend
API_KEY=replace_this_with_a_secure_api_key

# Email configuration (SMTP details, e.g. for registration or password reset)
EMAIL_USER=example@gmail.com
EMAIL_PASS=smtp_app_password

# Node Environment
NODE_ENV=development
